<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Enable high DPI auto-resizing for Windows Forms controls -->
    <add key="EnableWindowsFormsHighDpiAutoResizing" value="true" />
  </appSettings>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!-- Assembly binding redirects can be added here if needed -->
    </assemblyBinding>
  </runtime>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
